# Port exposé sur l'hôte par Nginx
APP_PORT=8085

# Base de données PostgreSQL
POSTGRES_USER=malvifactor
POSTGRES_PASSWORD=malvifactor_change_me
POSTGRES_DB=malvifactor

# Sécurité JWT (générer une clé aléatoire longue en production, ex: openssl rand -hex 32)
SECRET_KEY=replace-with-a-long-random-hex-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=90

# CORS (liste séparée par des virgules ou *)
CORS_ORIGINS=*
ENVIRONMENT=production
